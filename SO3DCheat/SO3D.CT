    <CheatEntry>
      <ID>7</ID>
      <Description>"修改移动速度"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)
label(returnhere)
label(originalcode1)
label(originalcode2)
label(exit)

newmem:
// 两个地址都 NOP，直接跳过原指令
jmp exit

originalcode1:
movss [ebx+000001A4],xmm0

originalcode2:
movss [ebx+000001A4],xmm0

exit:
jmp returnhere

// 第一个地址 NOP
"SO3D.exe"+473426:
jmp newmem
nop 3

// 第二个地址 NOP
"SO3D.exe"+4733B0:
jmp newmem
nop 3

returnhere:

[DISABLE]
// 禁用时恢复原始指令
"SO3D.exe"+473426:
movss [ebx+000001A4],xmm0

"SO3D.exe"+4733B0:
movss [ebx+000001A4],xmm0

dealloc(newmem)

</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
