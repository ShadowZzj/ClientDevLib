{
  "name": "ggtb-broker",
  "version": "0.1.0",
  "private": true,
  "description": "Broker bridging GGThreadBlock DLL instances and the web control UI",
  "bin": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/server.ts",
    "start": "node dist/server.js",
    "pack": "pkg . --output release/ggtb-broker.exe"
  },
  "pkg": {
    "targets": [
      "node20-win-x64"
    ],
    "assets": [
      "web-dist/**/*"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "express": "^4.19.2",
    "https-proxy-agent": "^7.0.5",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@yao-pkg/pkg": "^5.15.0",
    "esbuild": "^0.28.0",
    "nexe": "^4.0.0-rc.6",
    "postject": "^1.0.0-alpha.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
