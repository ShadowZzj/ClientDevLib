include_guard(GLOBAL)
get_filename_component(_client_controller_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/ClientJson.cmake")
find_package(Threads REQUIRED)
add_library(clientdev_http INTERFACE)
add_library(ClientDevLib::Http ALIAS clientdev_http)
target_include_directories(clientdev_http INTERFACE "${_client_controller_root}")
target_compile_features(clientdev_http INTERFACE cxx_std_17)
target_link_libraries(clientdev_http INTERFACE Threads::Threads)
if(WIN32)
    target_compile_definitions(clientdev_http INTERFACE WIN32_LEAN_AND_MEAN NOMINMAX)
    target_link_libraries(clientdev_http INTERFACE ws2_32)
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(_client_sqlite_arch x64)
    else()
        set(_client_sqlite_arch x86)
    endif()
    set(_client_sqlite_dir "${_client_controller_root}/General/ThirdParty/sqlite3/win/${_client_sqlite_arch}")
    add_library(clientdev_sqlite SHARED IMPORTED GLOBAL)
    set_target_properties(clientdev_sqlite PROPERTIES
        IMPORTED_IMPLIB "${_client_sqlite_dir}/sqlite3.lib"
        IMPORTED_LOCATION "${_client_sqlite_dir}/sqlite3.dll")
else()
    find_package(SQLite3 REQUIRED)
    add_library(clientdev_sqlite INTERFACE)
    target_link_libraries(clientdev_sqlite INTERFACE SQLite::SQLite3)
endif()
add_library(clientdev_versioned_json_store STATIC
    "${_client_controller_root}/General/ThirdParty/sqlite3pp/sqlite3pp.cpp"
    "${_client_controller_root}/General/util/Persistence/VersionedJsonStore.cpp")
add_library(ClientDevLib::VersionedJsonStore ALIAS clientdev_versioned_json_store)
target_compile_features(clientdev_versioned_json_store PUBLIC cxx_std_17)
target_include_directories(clientdev_versioned_json_store PUBLIC
    "${_client_controller_root}" "${_client_controller_root}/General/ThirdParty")
target_link_libraries(clientdev_versioned_json_store PUBLIC ClientDevLib::Json clientdev_sqlite Threads::Threads)
function(clientdev_deploy_sqlite target)
    if(WIN32)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                "$<TARGET_FILE:clientdev_sqlite>" "$<TARGET_FILE_DIR:${target}>/sqlite3.dll" VERBATIM)
    endif()
endfunction()
unset(_client_controller_root)
unset(_client_sqlite_arch)
unset(_client_sqlite_dir)
